# Fragment merged onto x86_64 defconfig via scripts/kconfig/merge_config.sh.
# Goal: a kernel that boots cleanly under QEMU with virtio peripherals, a
# 9p share for /work, and enough debug info that gdb is useful.

# ---- VirtIO ----------------------------------------------------------
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y

# ---- 9p (host /work mounted into the VM) -----------------------------
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# ---- serial console for -nographic + kgdb ----------------------------
# 8250 covers x86 PC machine; PL011 covers QEMU's "virt" machine on arm64.
# Enabling both is harmless on the unused arch — symbols just won't bind.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# ---- devtmpfs + initramfs --------------------------------------------
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y

# ---- module loading --------------------------------------------------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# ---- debug ------------------------------------------------------------
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_FRAME_POINTER=y
CONFIG_GDB_SCRIPTS=y
CONFIG_KGDB=y
CONFIG_KGDB_SERIAL_CONSOLE=y
CONFIG_MAGIC_SYSRQ=y

# ---- common conveniences ---------------------------------------------
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y

# ---- security: Landlock + seccomp + cgroup v2 ------------------------
# Landlock gives us per-agent filesystem sandboxing on Linux ≥ 5.13.
# Must appear in CONFIG_LSM to be activatable; the qemu cmdline can
# further override via `lsm=...` but the LSM has to be compiled in first.
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
# Minimal LSM stack — landlock is what we need; lockdown/yama/bpf are
# tiny and commonly built. apparmor + integrity dropped (they require
# CONFIG_AUDIT + CONFIG_IMA + much else; not needed for agentctl).
CONFIG_LSM="landlock,lockdown,yama,bpf"
# seccomp-bpf (usually enabled by defconfig but make it explicit).
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# cgroup v2 — required for cgroup.kill atomic subtree termination.
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
